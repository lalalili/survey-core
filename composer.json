{
    "name": "lalalili/survey-core",
    "description": "Reusable survey engine for Laravel — core domain, models, token personalization, submission, and export.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/validation": "^11.0|^12.0|^13.0",
        "illuminate/events": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "google/apiclient": "^2.15",
        "lalalili/audience-core": "^1.0",
        "laravel-at/laravel-image-sanitize": "^5.0",
        "masbug/flysystem-google-drive-ext": "^2.5",
        "openspout/openspout": "^4.0",
        "spatie/laravel-activitylog": "^5.0",
        "spatie/laravel-medialibrary": "^11.21",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "lalalili/email-campaign": "^1.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "laravel/pint": "^1.0",
        "larastan/larastan": "^3.0",
        "phpstan/phpstan": "~2.2.0",
        "lalalili/package-testing-support": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Lalalili\\SurveyCore\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lalalili\\SurveyCore\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lalalili\\SurveyCore\\SurveyCoreServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "suggest": {
        "lalalili/email-campaign": "Enables survey invitation delivery, transactional response notification tracking, and survey variables for campaign templates."
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/lalalili/audience-core.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/lalalili/email-campaign.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/lalalili/package-testing-support.git"
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse --configuration=phpstan.neon.dist --no-progress",
        "format": "pint"
    }
}
